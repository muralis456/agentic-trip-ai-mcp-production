# Required in production
DB_URL=jdbc:postgresql://localhost:5432/travel_agent
DB_USERNAME=travel_app
DB_PASSWORD=replace-with-a-strong-secret
SESSION_COOKIE_SECURE=true

# External providers
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=
TRAVEL_MCP_SERVER_URL=http://localhost:8090
OLLAMA_BASE_URL=http://localhost:11434

# Runtime safety
TRAVEL_MAX_CONCURRENT_PLANS=12
TRAVEL_MAX_CONCURRENT_PLANS_PER_USER=2
TRAVEL_MAX_CONCURRENT_SPECIALISTS=12
TRAVEL_PLAN_QUEUE_CAPACITY=40
TRAVEL_RATE_LIMIT_PER_WINDOW=6
TRAVEL_RATE_LIMIT_WINDOW_SECONDS=60
APP_BROWSER_ENABLED=false

# Password reset / local development mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
TRAVEL_AUTH_MAIL_FROM=noreply@agentictrip.local
TRAVEL_AUTH_RESET_BASE_URL=http://localhost:8081

# Phase 1 Agent Reliability / Security
TRAVEL_MODEL_FALLBACK_1=
TRAVEL_MODEL_FALLBACK_2=
TRAVEL_MCP_CLIENT_TIMEOUT_MS=15000
TRAVEL_MCP_GOVERNANCE_ENABLED=true
TRAVEL_MCP_MAX_ARGUMENT_BYTES=16384
TRAVEL_MCP_CIRCUIT_FAILURE_THRESHOLD=3
TRAVEL_MCP_CIRCUIT_OPEN_MS=30000
