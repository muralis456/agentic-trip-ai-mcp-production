<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AgenticTripAI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <style>
        :root {
            --bg-1: #020b18;
            --bg-2: #0a182d;
            --panel: rgba(18, 32, 52, 0.9);
            --panel-soft: rgba(255, 255, 255, 0.04);
            --border: rgba(255, 255, 255, 0.08);
            --primary: #2b8cff;
            --primary-2: #0e4ec4;
            --text: #edf5ff;
            --muted: #b3c7df;
            --chip: rgba(53, 125, 255, 0.16);
            --pill: rgba(77, 142, 255, 0.16);
            --shadow: rgba(4, 9, 19, 0.45);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            height: 100%;
            overflow: hidden;
            font-family: Arial, Helvetica, sans-serif;
            background: radial-gradient(circle at top, rgba(52, 116, 196, 0.18), transparent 35%),
                        linear-gradient(120deg, var(--bg-1), var(--bg-2));
            color: var(--text);
        }

        body {
            height: 100%;
        }

        .layout {
            display: flex;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
        }

        .sidebar {
            /* Keep the original two-pane application layout. The sidebar is part
               of the desktop UI; the main conversation fills all remaining space. */
            display: block;
            width: 300px;
            padding: 22px 18px 18px;
            background: rgba(9, 17, 31, 0.75);
            border-right: 1px solid var(--border);
            backdrop-filter: blur(6px);
            flex-shrink: 0;
            overflow-y: auto;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
            margin: 6px 4px 26px;
            color: #edf4ff;
        }

        .brand-mark {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3ec1ff, #1d6fff);
            box-shadow: 0 0 12px rgba(45, 130, 255, 0.7);
            position: relative;
        }

        .brand-mark::after {
            content: "";
            position: absolute;
            inset: 4px 4px auto auto;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,0.9);
        }

        .sidebar-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 14px 12px;
            margin-bottom: 18px;
        }

        .sidebar-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .user-field {
            width: 100%;
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 15px;
            color: #1f2d3d;
        }

        .sidebar-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 8px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 11px 12px;
            color: var(--text);
            font-size: 14px;
        }

        .tiny-icon {
            display: inline-flex;
            width: 18px;
            height: 18px;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            font-size: 11px;
            background: rgba(255,255,255,0.08);
        }

        .main {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            padding: 0;
        }

        .content {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-width: 0;
            min-height: 0;
            max-width: none;
            width: 100%;
            margin: 0;
            padding: 24px 28px 0;
        }

        .messages-pane {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            padding-bottom: 8px;
            scroll-behavior: smooth;
        }

        .hero {
            margin-top: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(91, 164, 255, 0.12);
            border: 1px solid rgba(123, 180, 255, 0.25);
            border-radius: 999px;
            padding: 7px 14px;
            font-size: 12px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #dfeeff;
            margin-bottom: 16px;
        }

        .title {
            font-size: clamp(2.3rem, 4vw, 4.2rem);
            line-height: 1.05;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.05em;
        }

        .subtitle {
            max-width: 760px;
            margin: 18px auto 0;
            font-size: 20px;
            line-height: 1.5;
            color: var(--muted);
        }

        .hero-visual {
            width: 100%;
            max-width: 960px;
            height: 146px;
            margin: 20px auto 18px;
            border-radius: 20px;
            background:
                linear-gradient(180deg, rgba(4, 12, 21, 0.18), rgba(7, 18, 30, 0.12)),
                linear-gradient(135deg, rgba(150, 196, 255, 0.32), rgba(72, 118, 190, 0.1)),
                url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 420"><rect width="1200" height="420" fill="transparent"/><path d="M0 300 C160 250, 260 260, 430 220 S760 170, 1200 270 L1200 420 L0 420 Z" fill="rgba(255,255,255,0.08)"/><path d="M0 320 C180 280, 300 260, 500 240 S830 210, 1200 290" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="2"/></svg>') center/cover no-repeat;
            border: 1px solid rgba(255,255,255,0.05);
            box-shadow: inset 0 0 22px rgba(255,255,255,0.04);
        }

        .city-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(160px, 1fr));
            gap: 14px;
            margin: 16px auto 18px;
            max-width: 960px;
        }

        .city-card {
            height: 104px;
            border-radius: 14px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 12px 10px;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.02em;
            color: #eef6ff;
            border: 1px solid rgba(255,255,255,0.07);
            box-shadow: 0 10px 24px rgba(0,0,0,0.15);
            text-shadow: 0 2px 12px rgba(0,0,0,0.35);
        }

        .tokyo { background: linear-gradient(135deg, rgba(17,179,255,0.22), rgba(4,39,70,0.18)), url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250"><rect width="400" height="250" fill="%230d1e32"/><path d="M0 180 L120 120 L190 170 L260 110 L400 180 L400 250 L0 250 Z" fill="%234b8bb8" opacity="0.5"/><circle cx="260" cy="90" r="35" fill="%23f4d58d" opacity="0.9"/><rect x="80" y="120" width="180" height="50" fill="%23fdf9ea" opacity="0.2"/></svg>') center/cover no-repeat; }
        .paris { background: linear-gradient(135deg, rgba(224,133,87,0.18), rgba(13,41,71,0.2)), url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250"><rect width="400" height="250" fill="%230d1e32"/><path d="M0 170 L140 120 L200 170 L260 110 L400 170 L400 250 L0 250 Z" fill="%23d37b61" opacity="0.5"/><path d="M180 62 L210 155 L150 155 Z" fill="%23f6d0a8" opacity="0.8"/><rect x="100" y="155" width="190" height="35" fill="%23f4e7d6" opacity="0.25"/></svg>') center/cover no-repeat; }
        .bangkok { background: linear-gradient(135deg, rgba(255,167,87,0.18), rgba(13,41,71,0.2)), url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250"><rect width="400" height="250" fill="%230d1e32"/><path d="M0 180 L120 100 L220 150 L400 120 L400 250 L0 250 Z" fill="%23e6ae5b" opacity="0.45"/><rect x="70" y="90" width="270" height="80" fill="%23a5d7ef" opacity="0.12"/><path d="M160 120 L190 90 L220 120" fill="none" stroke="%23f7d493" stroke-width="10" opacity="0.8"/></svg>') center/cover no-repeat; }
        .dubai { background: linear-gradient(135deg, rgba(86,143,255,0.18), rgba(13,41,71,0.2)), url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250"><rect width="400" height="250" fill="%230d1e32"/><path d="M0 180 Q150 120 400 150 L400 250 L0 250 Z" fill="%2390c4ff" opacity="0.3"/><path d="M110 120 H290 V160 H110 Z" fill="%23e9f0ff" opacity="0.10"/><path d="M80 210 H320" stroke="%23f5efda" stroke-width="8" opacity="0.28"/></svg>') center/cover no-repeat; }

        .prompt-box {
            max-width: 1000px;
            margin: 20px auto 0;
            background: rgba(15, 24, 39, 0.76);
            border: 1px solid rgba(140, 182, 255, 0.25);
            border-radius: 18px;
            box-shadow: 0 18px 36px rgba(0,0,0,0.22);
            overflow: hidden;
        }

        .prompt-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 22px 8px;
            color: #dfeeff;
            font-size: 13px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .prompt-header .tag {
            display: inline-flex;
            width: 18px;
            height: 18px;
            border-radius: 6px;
            background: rgba(90, 150, 255, 0.18);
            align-items: center;
            justify-content: center;
            font-size: 11px;
            border: 1px solid rgba(123, 180, 255, 0.2);
        }

        .prompt-body {
            padding: 8px 18px 20px;
        }

        .trip-suggestions {
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 14px;
            margin: 10px 0 16px;
        }

        .suggestion {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 90px;
            border-radius: 12px;
            padding: 14px 16px;
            background: linear-gradient(135deg, rgba(41, 118, 215, 0.72), rgba(28, 83, 175, 0.82));
            color: #f4f9ff;
            font-weight: 700;
            font-size: 18px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.12);
            box-shadow: inset 0 0 18px rgba(255,255,255,0.06);
        }

        textarea,
        input,
        select,
        button {
            font: inherit;
        }

        textarea {
            width: 100%;
            min-height: 116px;
            resize: vertical;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 14px;
            padding: 18px 18px 16px;
            color: var(--text);
            font-size: 17px;
            line-height: 1.55;
            outline: none;
            box-shadow: inset 0 0 18px rgba(0,0,0,0.08);
        }

        textarea:focus {
            border-color: rgba(126, 182, 255, 0.55);
            box-shadow: 0 0 0 3px rgba(71, 145, 255, 0.15), inset 0 0 18px rgba(0,0,0,0.06);
        }

        textarea::placeholder {
            color: rgba(220, 233, 255, 0.6);
        }

        .submit-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            margin-top: 14px;
            border: none;
            border-radius: 12px;
            padding: 18px 20px;
            background: linear-gradient(135deg, var(--primary), var(--primary-2));
            color: #f9fbff;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 10px 24px rgba(32, 91, 255, 0.38);
            transition: transform 0.15s ease, filter 0.15s ease;
        }

        .submit-button:hover {
            filter: brightness(1.05);
            transform: translateY(-1px);
        }

        .submit-button:disabled {
            opacity: 0.75;
            cursor: wait;
            transform: none;
        }

        .welcome-block {
            flex-shrink: 0;
        }

        .layout.has-chat .welcome-block {
            display: none;
        }

        .chat-thread {
            flex: 1 0 auto;
            padding: 8px 4px 12px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-height: 0;
        }

        .chat-empty {
            margin: auto;
            text-align: center;
            color: var(--muted);
            font-size: 15px;
            padding: 40px 16px;
        }

        .layout.has-chat .chat-empty {
            display: none;
        }

        .chat-msg {
            display: flex;
            gap: 12px;
            max-width: 100%;
            animation: msg-in 0.22s ease;
        }

        @keyframes msg-in {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: none; }
        }

        .chat-msg.user {
            flex-direction: row-reverse;
        }

        .chat-avatar {
            flex-shrink: 0;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            background: rgba(43, 140, 255, 0.2);
            border: 1px solid rgba(123, 180, 255, 0.25);
            color: #dfeeff;
        }

        .chat-msg.user .chat-avatar {
            background: rgba(255,255,255,0.08);
        }

        .chat-bubble {
            flex: 1;
            min-width: 0;
            background: rgba(9, 17, 31, 0.85);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 14px 16px;
            line-height: 1.6;
        }

        .chat-msg.user .chat-bubble {
            background: rgba(43, 140, 255, 0.16);
            border-color: rgba(123, 180, 255, 0.28);
            max-width: 85%;
            flex: 0 1 auto;
        }

        .chat-role {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .chat-body {
            white-space: pre-wrap;
            word-break: break-word;
            color: var(--text);
            font-size: 15px;
        }

        .chat-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }

        .chat-actions .submit-button {
            width: auto;
            margin-top: 0;
            padding: 10px 16px;
            font-size: 14px;
        }

        .chat-msg.assistant .chat-bubble {
            background: transparent;
            border: none;
            padding: 0;
            max-width: 100%;
        }

        .chat-msg.assistant .chat-role {
            margin-bottom: 10px;
            padding-left: 4px;
        }

        .trip-plan-card {
            background: linear-gradient(180deg, rgba(14, 28, 48, 0.96), rgba(9, 17, 31, 0.98));
            border: 1px solid rgba(123, 180, 255, 0.22);
            border-radius: 18px;
            padding: 22px 22px 18px;
            box-shadow: 0 18px 40px var(--shadow);
        }

        .trip-plan-card.error {
            padding: 18px;
            border-color: rgba(255, 120, 120, 0.35);
        }

        .trip-header {
            margin-bottom: 6px;
        }

        .trip-title {
            margin: 0 0 14px;
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .trip-rule {
            height: 1px;
            background: linear-gradient(90deg, rgba(123, 180, 255, 0.45), rgba(123, 180, 255, 0.08));
            margin: 14px 0;
        }

        .trip-meta {
            display: grid;
            gap: 8px;
            font-size: 15px;
            color: #dce9fb;
        }

        .trip-status {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 16px;
            align-items: center;
            margin-top: 14px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.03em;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(46, 204, 113, 0.14);
            border: 1px solid rgba(46, 204, 113, 0.35);
            color: #b8f5ce;
        }

        .status-pill.complete {
            background: rgba(43, 140, 255, 0.14);
            border-color: rgba(43, 140, 255, 0.35);
            color: #cfe4ff;
        }

        .quality-pill {
            font-size: 14px;
            color: var(--muted);
        }

        .plan-section {
            margin-top: 8px;
        }

        .plan-section-head {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #9ec0ef;
            padding: 12px 0 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .plan-section-body {
            font-size: 15px;
            line-height: 1.65;
            color: var(--text);
        }

        .plan-muted {
            color: var(--muted);
            margin: 0;
        }

        .plan-list {
            margin: 0;
            padding-left: 18px;
        }

        .plan-list li {
            margin-bottom: 8px;
        }

        .budget-table {
            display: grid;
            gap: 8px;
            max-width: 360px;
        }

        .budget-row {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            font-size: 15px;
        }

        .budget-row span:last-child {
            font-variant-numeric: tabular-nums;
            color: #e8f2ff;
        }

        .budget-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.12);
            margin: 4px 0;
        }

        .budget-total {
            font-weight: 700;
            margin-top: 2px;
        }

        .budget-remaining {
            color: var(--muted);
            font-size: 14px;
        }

        .review-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 8px;
        }

        .review-ok {
            color: #b8f5ce;
        }

        .review-warn {
            color: #ffd9a0;
        }

        .agent-details {
            margin-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 12px;
        }

        .agent-details summary {
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: var(--muted);
            list-style: none;
        }

        .agent-details summary::-webkit-details-marker {
            display: none;
        }

        .agent-details[open] summary {
            color: #cfe4ff;
            margin-bottom: 10px;
        }

        .agent-details-body {
            display: grid;
            gap: 10px;
        }

        .agent-pre {
            margin: 0;
            padding: 12px;
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 12px;
            line-height: 1.5;
            color: #b8cbe4;
            white-space: pre-wrap;
            word-break: break-word;
            max-height: 220px;
            overflow: auto;
        }

        .plan-legacy {
            margin: 0;
            white-space: pre-wrap;
            font-family: inherit;
            font-size: 14px;
            line-height: 1.6;
        }

        .chat-actions.plan-actions {
            justify-content: center;
            margin-top: 16px;
            padding-top: 4px;
        }

        .chat-actions .ghost-button {
            background: transparent;
            border: 1px solid rgba(123, 180, 255, 0.35);
            box-shadow: none;
            color: #dfeeff;
        }

        .chat-actions.plan-actions {
            justify-content: center;
            margin-top: 16px;
            padding-top: 4px;
        }

        .chat-actions.plan-actions .submit-button {
            min-width: 120px;
        }

        .composer-wrap {
            flex-shrink: 0;
            padding: 10px 0 max(18px, env(safe-area-inset-bottom));
            background: linear-gradient(180deg, rgba(2, 11, 24, 0.55), var(--bg-1) 55%);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .composer-bar {
            display: flex;
            align-items: flex-end;
            gap: 6px;
            width: 100%;
            padding: 8px 10px 8px 8px;
            background: rgba(22, 28, 38, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 28px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
        }

        .composer-icon-btn {
            width: 36px;
            height: 36px;
            margin-bottom: 2px;
            border: none;
            border-radius: 50%;
            background: transparent;
            color: #eef4ff;
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s ease;
        }

        .composer-icon-btn:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .composer-input-wrap {
            flex: 1 1 auto;
            min-width: 0;
            padding: 2px 4px;
            display: flex;
            align-items: flex-end;
        }

        .composer-bar textarea {
            display: block;
            width: 100%;
            height: 28px;
            min-height: 28px;
            max-height: 220px;
            resize: none;
            overflow-y: hidden;
            border: none;
            background: transparent;
            padding: 4px 6px;
            color: var(--text);
            font-size: 16px;
            line-height: 1.45;
            outline: none;
            box-shadow: none;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        /* Keep the composer clean while typing. The scrollbar appears only
           when the prompt exceeds the maximum height, and never shows the
           native up/down arrow buttons. */
        .composer-bar textarea::-webkit-scrollbar {
            width: 0;
            height: 0;
        }

        .composer-bar textarea.has-overflow {
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(170, 190, 220, 0.45) transparent;
        }

        .composer-bar textarea.has-overflow::-webkit-scrollbar {
            width: 5px;
