        .content,
        .messages-pane,
        .chat-thread,
        .chat-msg,
        .chat-msg.assistant,
        .chat-msg.assistant .chat-bubble {
            max-width: none;
            width: 100%;
        }

        .composer-wrap {
            width: 100%;
            max-width: none;
        }


        .chat-thread {
            gap: 22px;
        }

        .chat-msg.user .chat-bubble {
